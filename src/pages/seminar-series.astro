---
import BaseLayout from '../layouts/BaseLayout.astro';

const today = new Date();

const terms = [
  {
    name: 'Autumn Term',
    seminars: [
      { date: '2026-10-14', speaker: 'Almuth McDowall' },
      { date: '2026-10-21', speaker: 'Daniel Yon' },
      { date: '2026-10-28', speaker: 'Denis Mareschal' },
      { date: '2026-11-04', speaker: 'Hugo Spiers' },
      { date: '2026-11-18', speaker: 'Patrizia Pezzoli' },
      { date: '2026-11-25', speaker: 'Ken Valyear' },
      { date: '2026-12-02', speaker: 'Benedetto De Martino' },
      { date: '2026-12-09', speaker: 'Ines Violante' },
      { date: '2026-12-16', speaker: 'Geoff Haddock' },
    ],
  },
  {
    name: 'Spring Term',
    seminars: [
      { date: '2027-01-20', speaker: 'David Carey' },
      { date: '2027-01-27', speaker: 'Dejan Draschkow' },
      { date: '2027-02-03', speaker: 'Noam Goldway' },
      { date: '2027-02-10', speaker: 'Irene Di Giulio' },
      { date: '2027-02-24', speaker: 'Smadar Cohen-Chen' },
      { date: '2027-03-03', speaker: 'Clara Humpston' },
      { date: '2027-03-10', speaker: 'Amy Pearson' },
      { date: '2027-03-17', speaker: 'Karoline Kuchenbaecker' },
    ],
  },
  {
    name: 'Summer Term',
    seminars: [
      { date: '2027-04-28', speaker: 'Charlotte Rae' },
      { date: '2027-05-05', speaker: 'Aidan J. Horner' },
      { date: '2027-05-12', speaker: 'Andrea Luppi' },
      { date: '2027-05-19', speaker: 'Catherine Preston' },
    ],
  },
];

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

function isPast(dateStr: string) {
  return new Date(dateStr) < today;
}
---
<BaseLayout title="Seminar Series">
  <div class="page-header">
    <h1>Seminar Series 2026–2027</h1>
    <p class="page-header__subtitle">School of Psychological Sciences, Birkbeck, University of London</p>
  </div>

  <section class="section">
    <div class="container">
      <div class="info-card">
        <p>Join us for the seminar series of the School of Psychological Sciences, exploring diverse topics in psychology and cognitive neuroscience.</p>
        <ul class="info-card__details">
          <li><strong>When:</strong> Wednesdays, 1–2 PM</li>
          <li><strong>Where:</strong> Room 612, 6th Floor, Malet Street Building, Birkbeck, University of London</li>
          <li><strong>Open to everyone.</strong> Light refreshments provided.</li>
          <li><strong>Organiser:</strong> <a href="mailto:s.seghezzi@bbk.ac.uk">s.seghezzi@bbk.ac.uk</a></li>
        </ul>
      </div>

      {terms.map(term => (
        <div class="term">
          <h2 class="term__name">{term.name}</h2>
          <ul class="seminar-list">
            {term.seminars.map(sem => (
              <li class={`seminar${isPast(sem.date) ? ' seminar--past' : ''}`}>
                <time class="seminar__date" datetime={sem.date}>{formatDate(sem.date)}</time>
                <span class="seminar__speaker">{sem.speaker}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header__subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-top: 0.5rem;
  }
  .info-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    margin-bottom: 3rem;
  }
  .info-card p {
    margin-bottom: 1rem;
    color: var(--color-text);
  }
  .info-card__details {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .info-card__details li {
    padding: 0.3rem 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
  .term {
    margin-bottom: 3rem;
  }
  .term__name {
    font-size: 1.4rem;
    font-weight: 600;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }
  .seminar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .seminar {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .seminar:last-child {
    border-bottom: none;
  }
  .seminar__date {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 500;
  }
  .seminar__speaker {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .seminar--past {
    opacity: 0.4;
  }
  @media (max-width: 600px) {
    .seminar {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
